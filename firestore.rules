rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Teachers Collection Security Rules
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == teacherId;
      allow delete: if false; // Prevent accidental teacher deletion
    }

    // School Classes Collection
    match /schoolClasses/{classId} {
      allow read: if true; // Public read for invite code verification
      allow write: if isAuthenticated();
    }

    // Student Activity Records (Reading, Emotion, Duty, Goals, Praise)
    match /{collectionName}/{docId} {
      // Restrict access to authenticated users or users matching class invite code
      allow read, write: if isAuthenticated() || request.resource.data.classInviteCode != null;
    }

    // Private Teacher Notes (Protected: Teachers only)
    match /teacherNotes/{noteId} {
      allow read, write: if isAuthenticated();
    }
  }
}
